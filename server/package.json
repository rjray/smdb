{
  "name": "@smdb/server",
  "version": "0.1.0",
  "description": "SMDB Server",
  "main": "dist/server.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "nodemon --delay 2 --ext yaml,js,ts -w src src/server.ts",
    "reset": "rm -f smdb.db; tsx src/bootstrap.ts && ./importer/import_refs.pl ~/work/nmrdb/models.db",
    "clean": "rm -rf dist coverage",
    "gen-keys": "openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -sha256 -days 3650 -nodes -subj \"/C=US/ST=California/CN=localhost\"",
    "lint:openapi": "spectral lint src/openapi.yaml",
    "lint": "pnpm lint:openapi && pnpm eslint src",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "@smdb/types": "workspace:*",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "csv-parse": "^5.6.0",
    "exegesis": "^4.3.0",
    "exegesis-express": "^4.0.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "5.1.7",
    "ts-pattern": "^5.9.0",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.16.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.1"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "tsx"
    }
  }
}
